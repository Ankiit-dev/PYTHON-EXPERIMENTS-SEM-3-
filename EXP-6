while True:

    password = input("Enter password: ")

    if password == "stop":
        break

    has_upper = False
    has_lower = False

    for ch in password:

        if ch.isupper():
            has_upper = True

        if ch.islower():
            has_lower = True

    if len(password) >= 8 and has_upper and has_lower:
        print("Strong password")
    else:
        print("Weak password")
