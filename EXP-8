import math

def calculate_area(shape, *args):

    if shape == "circle":
        radius = args[0]
        return math.pi * radius ** 2

    elif shape == "rectangle":
        length = args[0]
        width = args[1]
        return length * width

    elif shape == "triangle":
        base = args[0]
        height = args[1]
        return 0.5 * base * height


print(calculate_area("circle", 5))
print(calculate_area("rectangle", 10, 5))
print(calculate_area("triangle", 10, 4))
